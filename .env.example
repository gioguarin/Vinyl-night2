# Database (SQLite file lives in prisma/)
DATABASE_URL="file:./dev.db"

# Recognition provider: mock | audd | acrcloud
# mock = no credits needed, cycles a fake crate so you can test the whole loop
RECOGNITION_PROVIDER="mock"

# AudD (https://audd.io) — set token and switch RECOGNITION_PROVIDER=audd
AUDD_API_TOKEN=""

# Dedupe tuning
CONFIDENCE_THRESHOLD="0.6"
DEDUPE_WINDOW_MIN="8"

# ACRCloud (optional alternative provider)
ACRCLOUD_HOST=""
ACRCLOUD_ACCESS_KEY=""
ACRCLOUD_ACCESS_SECRET=""

# Spotify app (https://developer.spotify.com/dashboard)
# Add the redirect URI below to the app settings; in dev mode also allowlist your account.
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_REDIRECT_URI="http://localhost:3000/api/spotify/callback"
